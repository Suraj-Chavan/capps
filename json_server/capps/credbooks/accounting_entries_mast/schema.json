{
        "DATA_MODEL": "CA_ACCOUNT_ENTRY_MAST",
        "NAME": "ACCOUNTING ENTRIES",
        "DEFAULT_VIEW": "list",
        "ACTIONS": [
            "CREATE",
            "UPDATE",
            "DELETE",
            "EXPORT"
        ],
        "SORT_FIELD": "VALUEDATE",
        "SORT_ORDER": "DESC",
        "FIELDS": {
            "ID": {
                "fieldtype": "float",
                "maxlength": null,
                "required": 0,
                "iskey": 1
            },
            "EVENT_RECORD_ID": {
                "fieldtype": "float",
                "maxlength": null,
                "required": 0,
                "hidden": 1,
                "default": 1,
                "linked_to": {
                    "ref": "event_data",
                    "key": "ID",
                    "display_name": "ID"
                }
            },
            "SECTIONBREAK1": {
                "fieldname": "section_break",
                "fieldtype": "section_break",
                "label": "General Details"
            },
            "BOOK": {
                "fieldtype": "select",
                "maxlength": 250,
                "required": 1,
                "in_standard_filter": 1,
                "linked_to": {
                    "ref": "book",
                    "key": "BOOK",
                    "display_name": "BOOK"
                }
            },
            "POLICY": {
                "fieldtype": "select",
                "maxlength": 250,
                "required": 1,
                "in_standard_filter": 1,
                "linked_to": {
                    "ref": "policy",
                    "key": "POLICY",
                    "display_name": "POLICY"
                }
            },
            "EVENT_NAME": {
                "fieldtype": "select",
                "maxlength": 250,
                "required": 1,
                "in_standard_filter": 1,
                "linked_to": {
                    "ref": "static_master",
                    "key": "CODE",
                    "display_name": "DESCR",
                    "filter": [
                        {
                            "field": "MODULE_NAME",
                            "asgn": "eq",
                            "value": "MAIN.EVENTS_NAME"
                        }
                    ]
                }
            },
            "VOUCHER_NAME": {
                "fieldtype": "textfield",
                "maxlength": 250,
                "required": 0,
                "in_standard_filter": 1,
                "column_filterable": 1
            },
            "VOUCHER_NO": {
                "fieldtype": "textfield",
                "maxlength": 250,
                "required": 0,
                "in_standard_filter": 1,
                "hidden": 1
            },
            "VALUEDATE": {
                "fieldtype": "date",
                "maxlength": null,
                "required": 0,
                "in_standard_filter": 1,
                "column_filterable": 1
            },
            "ASSET_CLASS_CODE": {
                "fieldtype": "select",
                "maxlength": 50,
                "required": 1,
                "column_filterable": 1,
                "linked_to": {
                    "ref": "static_master",
                    "key": "CODE",
                    "display_name": "DESCR",
                    "filter": [
                        {
                            "field": "MODULE_NAME",
                            "asgn": "eq",
                            "value": "MAIN.ASSET_CLASS"
                        }
                    ]
                }
            },
            "IS_MANUAL": {
                "fieldtype": "checkbox",
                "maxlength": 50,
                "checked-value": "Y",
                "unchecked-value": "N",
                "default": "Y",
                "required": 0,
                "disabled": 1,
                "label": "Is Manual",
                "in_standard_filter": 1,
                "hidden": 1
            },
            "BATCH_NO": {
                "fieldtype": "float",
                "maxlength": null,
                "required": 0,
                "hidden": 1,
                "column_filterable": 1,
                "linked_to": {
                    "ref": "process",
                    "display_name": "ID",
                    "key": "ID"
                }
            },
            "NARRATION": {
                "fieldtype": "textfield",
                "maxlength": 500,
                "required": 1
            },
            "DEAL_NO": {
                "fieldtype": "textfield",
                "maxlength": 250,
                "required": 1
            },
            "SECTIONBREAK2": {
                "fieldname": "section_break",
                "fieldtype": "section_break",
                "label": "Fund Details"
            },
            "PORTCODE": {
                "fieldtype": "select",
                "maxlength": null,
                "required": 1,
                "linked_to": {
                    "ref": "portfolios",
                    "key": "PORTCODE",
                    "display_name": "PORTFOLIO"
                }
            },
            "PORTFOLIO": {
                "fieldtype": "textfield",
                "maxlength": 250,
                "required": 0,
                "disabled": 1,
                "in_standard_filter": 1
            },
            "ACCOUNTING_UNIT_CODE": {
                "fieldtype": "float",
                "maxlength": null,
                "required": 0,
                "disabled": 1
            },
            "ACCOUNTING_UNIT_NAME": {
                "fieldtype": "textfield",
                "maxlength": 250,
                "required": 0,
                "in_standard_filter": 1,
                "disabled": 1
            },
            "PCY_CURR": {
                "fieldtype": "select",
                "maxlength": 50,
                "required": 0,
                "disabled": 1,
                "linked_to": {
                    "ref": "static_master",
                    "key": "CODE",
                    "display_name": "DESCR",
                    "filter": [
                        {
                            "field": "MODULE_NAME",
                            "asgn": "eq",
                            "value": "MAIN.CURRENCY"
                        }
                    ]
                }
            },
            "SECURITY_CURR": {
                "fieldtype": "select",
                "maxlength": 50,
                "required": 1,
                "linked_to": {
                    "ref": "static_master",
                    "key": "CODE",
                    "display_name": "DESCR",
                    "filter": [
                        {
                            "field": "MODULE_NAME",
                            "asgn": "eq",
                            "value": "MAIN.CURRENCY"
                        }
                    ]
                }
            },
            "LCY_CURR": {
                "fieldtype": "textfield",
                "maxlength": 50,
                "required": 1,
                "disabled": 1
            },
            "GCY_CURR": {
                "fieldtype": "textfield",
                "maxlength": 50,
                "required": 1,
                "disabled": 1
            },
            "ACCOUNTING_ENTRIES_DETAILS": {
                "fieldtype": "table",
                "label": "Entry Details",
                "required": 1,
                "ref": "accounting_entries_details",
                "parent.field": "PARENT_ID"
            },
            "AUTHORISED": {
                "fieldtype": "textfield",
                "maxlength": 1,
                "default": "N",
                "required": 0,
                "in_standard_filter": 1,
                "hidden": 1
            },
            "FILE_ID": {
                "fieldtype": "float",
                "required": 0,
                "hidden": 1,
                "linked_to": {
                    "ref": "file_interface",
                    "key": "ID",
                    "display_name": "FILE_ID"
                }
            }
        }
  }