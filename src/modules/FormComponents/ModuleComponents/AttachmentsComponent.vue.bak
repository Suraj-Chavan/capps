	margin-left: 2px;
	margin-bottom: 0;
	padding-bottom: 0;
	padding-top: 0;
	height: 24px;
	display: flex;
	align-items: center;
	opacity: 0;
	pointer-events: none;
	transition: opacity 0.2s;
}

@media (max-width: 600px) {
	.attachment-card {
		flex-direction: column;
		align-items: stretch;
	}
	
