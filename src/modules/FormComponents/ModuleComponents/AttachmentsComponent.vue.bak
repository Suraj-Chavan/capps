	font-size: 1em;
	font-weight: 600;
	margin-bottom: 2px;
	color: #22223b;
	white-space: normal;
	word-break: break-word;
	overflow: visible;
	text-overflow: unset;
	max-width: 100%;
	display: block;
	line-height: 1.4;
}

.file-meta {
	font-size: 0.93em;
	color: #6c757d;
	margin-bottom: 0;
	white-space: normal;
	word-break: break-word;
	overflow: visible;
	text-overflow: unset;
	max-width: 100%;
	display: block;
	line-height: 1.3;
	margin-top: 2px;
}

.min-width-0 {
	min-width: 0 !important;
	flex-basis: 0;
	flex-shrink: 1;
	flex-grow: 1;
	overflow: hidden;
}

.file-actions {
