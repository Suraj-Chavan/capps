	box-shadow: 0 1px 8px rgba(60,60,100,0.08);
	border: 1px solid #e0e7ef;
	transition: box-shadow 0.2s, background 0.2s;
	display: flex;
	align-items: flex-start;
	padding: 10px 10px 10px 10px;
	margin-bottom: 10px;
}

